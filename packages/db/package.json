{
  "name": "@erp/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema=./prisma/schema.prisma",
    "db:seed": "ts-node ../../seed.ts",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "migrate-legacy:dry-run": "NODE_PATH=../../node_modules/.pnpm/node_modules ts-node --skip-project --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' migrate-legacy/index.ts dry-run",
    "migrate-legacy:import": "NODE_PATH=../../node_modules/.pnpm/node_modules ts-node --skip-project --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' migrate-legacy/index.ts import",
    "migrate-legacy:cleanup": "NODE_PATH=../../node_modules/.pnpm/node_modules ts-node --skip-project --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' migrate-legacy/index.ts cleanup",
    "migrate-freecolors": "NODE_PATH=../../node_modules/.pnpm/node_modules ts-node --skip-project --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' migrate-legacy/merge-freecolors.ts",
    "update-from-csv": "NODE_PATH=../../node_modules/.pnpm/node_modules ts-node --skip-project --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' migrate-legacy/update-from-csv.ts",
    "build": "tsc -p tsconfig.json"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0",
    "xlsx": "^0.18.5"
  }
}
